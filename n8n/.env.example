# Copier ce fichier en .env puis remplir les valeurs :   cp .env.example .env
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être commité.

# --- Versions des images (épingler une version précise en production) ---
N8N_VERSION=2.49.5
POSTGRES_VERSION=17-alpine
MAILPIT_VERSION=latest

# --- PostgreSQL ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Mot de passe long et aléatoire. Générer avec :  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- n8n ---
# Clé qui chiffre les identifiants (Gmail, API Claude...) stockés en base.
# Générer avec :  openssl rand -hex 32
# ATTENTION : si elle est perdue, tous les identifiants enregistrés deviennent illisibles. La sauvegarder.
N8N_ENCRYPTION_KEY=
TIMEZONE=Europe/Paris
# Expéditeur des e-mails système de n8n (fictif)
N8N_SMTP_SENDER=n8n@agence-demo.local
